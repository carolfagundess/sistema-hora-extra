<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { titulo: 'Login' }) %>
</head>
<body>
  <main class="tela-auth">
    <div class="cartao-auth">
      <div class="marca-auth">
        <span class="marca-icone">CRC</span>
        <span class="marca-texto"><strong>Horas Extras</strong></span>
      </div>

      <h1>Entrar</h1>
      <p class="subtitulo">Acesse com seu e-mail corporativo para lançar horas extras.</p>

      <% if (erro) { %>
        <p class="alerta alerta-erro"><%= erro %></p>
      <% } %>

      <form method="POST" action="/login">
        <div class="campo">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" placeholder="nome@empresa.com" required autofocus>
        </div>
        <div class="campo">
          <label for="senha">Senha</label>
          <input type="password" id="senha" name="senha" placeholder="••••••••" required>
        </div>
        <button type="submit" class="primario">Entrar</button>
      </form>
    </div>
  </main>
</body>
</html>
