<header class="topbar">
  <div class="topbar-interno">
    <a href="/" class="marca">
      <span class="marca-icone">CRC</span>
      <span class="marca-texto">Horas Extras</span>
    </a>

    <nav class="nav-principal">
      <% if (usuario.perfil === 'colaborador' || usuario.perfil === 'sublider') { %>
        <a href="/lancamentos" class="nav-link <%= ativo === 'lancamentos' ? 'nav-link-ativo' : '' %>">Meus lançamentos</a>
      <% } %>
      <% if (usuario.perfil === 'sublider' || usuario.perfil === 'lider') { %>
        <a href="/aprovacao" class="nav-link <%= ativo === 'aprovacao' ? 'nav-link-ativo' : '' %>">Aprovações</a>
        <a href="/relatorio" class="nav-link <%= ativo === 'relatorio' ? 'nav-link-ativo' : '' %>">Visão do setor</a>
      <% } %>
    </nav>

    <div class="topbar-usuario">
      <span class="avatar"><%= usuario.nome.charAt(0).toUpperCase() %></span>
      <span class="topbar-usuario-info">
        <span class="topbar-usuario-nome"><%= usuario.nome %></span>
        <span class="topbar-usuario-perfil"><%= usuario.perfil %></span>
      </span>
      <form method="POST" action="/logout">
        <button type="submit" class="botao-sair" title="Sair" aria-label="Sair">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>
      </form>
    </div>
  </div>
</header>
