<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Painel de aprovacao - Controle de Horas Extras</title>
  <link rel="stylesheet" href="/css/estilo.css">
</head>
<body>
  <main class="pagina-larga">
    <header class="cabecalho">
      <div>
        <h1>Painel de aprovacao</h1>
        <p><%= usuario.nome %> &middot; <%= usuario.perfil %></p>
      </div>
      <nav class="nav-topo">
        <a href="/lancamentos">Meus lancamentos</a>
        <form method="POST" action="/logout">
          <button type="submit" class="link">Sair</button>
        </form>
      </nav>
    </header>

    <% if (mensagem) { %>
      <p class="aviso"><%= mensagem %></p>
    <% } %>

    <section class="cartao">
      <h2>Pendentes (<%= pendentes.length %>)</h2>

      <% if (pendentes.length === 0) { %>
        <p>Nenhum lancamento aguardando aprovacao.</p>
      <% } else { %>
        <form method="POST" action="/aprovacao/lote" id="form-lote">
          <table>
            <thead>
              <tr>
                <th><input type="checkbox" id="marcar-todos"></th>
                <th>Colaborador</th>
                <th>Data</th>
                <th>Horario</th>
                <th>Total</th>
                <th>Motivo</th>
                <th>Decisao individual</th>
              </tr>
            </thead>
            <tbody>
              <% pendentes.forEach(function(l) { %>
                <tr>
                  <td><input type="checkbox" name="ids" value="<%= l.id %>" class="marcar-item" form="form-lote"></td>
                  <td><%= l.usuario_nome %></td>
                  <td><%= l.data %></td>
                  <td><%= l.hora_inicio %> - <%= l.hora_fim %></td>
                  <td><%= formatarMinutos(l.total_minutos) %></td>
                  <td><%= l.motivo %></td>
                  <td>
                    <details>
                      <summary>Decidir</summary>
                      <form method="POST" action="/aprovacao/<%= l.id %>/decidir" class="formulario-edicao">
                        <input type="text" name="comentario" placeholder="Comentario (opcional)" maxlength="300">
                        <button type="submit" name="decisao" value="aprovado" class="botao-ok">Aprovar</button>
                        <button type="submit" name="decisao" value="reprovado" class="botao-negar">Reprovar</button>
                      </form>
                    </details>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>

          <div class="acoes-lote">
            <input type="text" name="comentario" placeholder="Comentario para o lote (opcional)" maxlength="300">
            <button type="submit" name="decisao" value="aprovado" class="botao-ok">Aprovar selecionados</button>
            <button type="submit" name="decisao" value="reprovado" class="botao-negar">Reprovar selecionados</button>
          </div>
        </form>
      <% } %>
    </section>
  </main>

  <script>
    var marcarTodos = document.getElementById('marcar-todos');
    if (marcarTodos) {
      marcarTodos.addEventListener('change', function () {
        document.querySelectorAll('.marcar-item').forEach(function (cb) {
          cb.checked = marcarTodos.checked;
        });
      });
    }
  </script>
</body>
</html>
