<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { titulo: 'Painel de aprovação' }) %>
</head>
<body>
  <%- include('partials/topo', { usuario: usuario, ativo: 'aprovacao' }) %>

  <main class="pagina">
    <div class="cabecalho-pagina">
      <div>
        <h1>Painel de aprovação</h1>
        <p class="subtitulo">Revise e decida sobre as horas extras pendentes do setor.</p>
      </div>
    </div>

    <div class="grade-estatisticas">
      <div class="estatistica">
        <div class="estatistica-rotulo">Aguardando decisão</div>
        <div class="estatistica-valor cor-aviso"><%= pendentes.length %></div>
      </div>
    </div>

    <% if (mensagem) { %>
      <p class="alerta alerta-info"><%= mensagem %></p>
    <% } %>

    <section class="cartao">
      <div class="cartao-cabecalho">
        <h2>Pendentes</h2>
        <span class="contagem-pill"><%= pendentes.length %></span>
      </div>

      <% if (pendentes.length === 0) { %>
        <p class="estado-vazio">Nenhum lançamento aguardando aprovação.</p>
      <% } else { %>
        <form method="POST" action="/aprovacao/lote" id="form-lote">
          <div class="tabela-wrap">
            <table>
              <thead>
                <tr>
                  <th><input type="checkbox" id="marcar-todos"></th>
                  <th>Colaborador</th>
                  <th>Data</th>
                  <th>Horário</th>
                  <th>Total</th>
                  <th>Motivo</th>
                  <th>Decisão individual</th>
                </tr>
              </thead>
              <tbody>
                <% pendentes.forEach(function(l) { %>
                  <tr>
                    <td><input type="checkbox" name="ids" value="<%= l.id %>" class="marcar-item" form="form-lote"></td>
                    <td><strong><%= l.usuario_nome %></strong></td>
                    <td><%= l.data %></td>
                    <td class="celula-secundaria"><%= l.hora_inicio %>–<%= l.hora_fim %></td>
                    <td><strong><%= formatarMinutos(l.total_minutos) %></strong></td>
                    <td><%= l.motivo %></td>
                    <td>
                      <details class="acao-inline">
                        <summary>Decidir</summary>
                        <form method="POST" action="/aprovacao/<%= l.id %>/decidir" class="formulario-inline">
                          <input type="text" name="comentario" placeholder="Comentário (opcional)" maxlength="300">
                          <button type="submit" name="decisao" value="aprovado" class="botao-sucesso">Aprovar</button>
                          <button type="submit" name="decisao" value="reprovado" class="botao-perigo">Reprovar</button>
                        </form>
                      </details>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="acoes-lote">
            <input type="text" name="comentario" placeholder="Comentário para o lote (opcional)" maxlength="300">
            <button type="submit" name="decisao" value="aprovado" class="botao-sucesso">Aprovar selecionados</button>
            <button type="submit" name="decisao" value="reprovado" class="botao-perigo">Reprovar selecionados</button>
          </div>
        </form>
      <% } %>
    </section>
  </main>

  <script>
    var marcarTodos = document.getElementById('marcar-todos');
    if (marcarTodos) {
      marcarTodos.addEventListener('change', function () {
        document.querySelectorAll('.marcar-item').forEach(function (cb) {
          cb.checked = marcarTodos.checked;
        });
      });
    }
  </script>
</body>
</html>
