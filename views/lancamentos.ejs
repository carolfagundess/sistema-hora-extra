<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { titulo: 'Meus lançamentos' }) %>
</head>
<body>
  <%- include('partials/topo', { usuario: usuario, ativo: 'lancamentos' }) %>

  <main class="pagina">
    <div class="cabecalho-pagina">
      <div>
        <h1>Meus lançamentos</h1>
        <p class="subtitulo">Registre suas horas extras e acompanhe o status de aprovação.</p>
      </div>
    </div>

    <div class="grade-estatisticas">
      <div class="estatistica">
        <div class="estatistica-rotulo">Aprovado no mês</div>
        <div class="estatistica-valor cor-sucesso"><%= totalMesFormatado %></div>
      </div>
    </div>

    <% if (erro) { %>
      <p class="alerta alerta-erro"><%= erro %></p>
    <% } %>

    <section class="cartao">
      <div class="cartao-cabecalho">
        <h2>Novo lançamento</h2>
      </div>
      <form method="POST" action="/lancamentos" class="formulario-lancamento">
        <div class="campo campo-data">
          <label for="data">Data</label>
          <input type="date" id="data" name="data" required>
        </div>
        <div class="campo campo-hora">
          <label for="hora_inicio">Início</label>
          <input type="time" id="hora_inicio" name="hora_inicio" required>
        </div>
        <div class="campo campo-hora">
          <label for="hora_fim">Fim</label>
          <input type="time" id="hora_fim" name="hora_fim" required>
        </div>
        <div class="campo campo-motivo">
          <label for="motivo">Motivo</label>
          <input type="text" id="motivo" name="motivo" maxlength="200" placeholder="Ex.: fechamento mensal" required>
        </div>
        <button type="submit" class="primario">Lançar</button>
      </form>
    </section>

    <section class="cartao">
      <div class="cartao-cabecalho">
        <h2>Histórico</h2>
        <span class="contagem-pill"><%= lancamentos.length %></span>
      </div>

      <% if (lancamentos.length === 0) { %>
        <p class="estado-vazio">Nenhum lançamento ainda. Use o formulário acima para registrar o primeiro.</p>
      <% } else { %>
        <div class="tabela-wrap">
          <table>
            <thead>
              <tr>
                <th>Data</th>
                <th>Horário</th>
                <th>Total</th>
                <th>Motivo</th>
                <th>Status</th>
                <th>Comentário</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% lancamentos.forEach(function(l) { %>
                <tr>
                  <td><%= formatarData(l.data) %></td>
                  <td class="celula-secundaria"><%= l.hora_inicio %>–<%= l.hora_fim %></td>
                  <td><strong><%= formatarMinutos(l.total_minutos) %></strong></td>
                  <td><%= l.motivo %></td>
                  <td><span class="status-pill status-<%= l.status %>"><%= l.status %></span></td>
                  <td class="celula-secundaria"><%= l.comentario || '—' %></td>
                  <td>
                    <% if (l.status === 'pendente') { %>
                      <details class="acao-inline">
                        <summary>Editar</summary>
                        <form method="POST" action="/lancamentos/<%= l.id %>/editar" class="formulario-inline">
                          <input type="date" name="data" value="<%= l.data %>" required>
                          <input type="time" name="hora_inicio" value="<%= l.hora_inicio %>" required>
                          <input type="time" name="hora_fim" value="<%= l.hora_fim %>" required>
                          <input type="text" name="motivo" value="<%= l.motivo %>" maxlength="200" required>
                          <button type="submit" class="botao-secundario">Salvar</button>
                        </form>
                      </details>
                      <div class="linha-acoes">
                        <form method="POST" action="/lancamentos/<%= l.id %>/excluir" onsubmit="return confirm('Excluir este lançamento?');">
                          <button type="submit" class="botao-texto">Excluir</button>
                        </form>
                      </div>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
