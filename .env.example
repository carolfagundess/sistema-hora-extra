# Copie para .env e preencha antes de subir em producao.
# NUNCA commitar o .env real (ja esta no .gitignore).

NODE_ENV=production

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Caminho do arquivo SQLite. Use um caminho fora da pasta do app
# (ex: /var/lib/horas-extras/dados.sqlite) para sobreviver a deploys.
DB_PATH=/var/lib/horas-extras/dados.sqlite

PORT=3000

# So mude para "true" depois que o dominio + HTTPS (Caddy) estiverem no
# ar. Antes disso, deixe "false" (ou omita) — com "true" sem HTTPS o
# navegador descarta o cookie de sessao e ninguem consegue logar.
SESSION_SECURE_COOKIE=false
