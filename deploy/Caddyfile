# Configuracao ativa agora: sem dominio, so IP, HTTP puro (porta 80).
# Troque para o bloco de dominio (comentado abaixo) assim que houver um
# dominio apontando para o IP da VM — o Caddy emite HTTPS automatico via
# Let's Encrypt sozinho, sem configuracao extra.
:80 {
	reverse_proxy localhost:3000
}

